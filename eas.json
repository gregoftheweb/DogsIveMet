{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ADS_TEST": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "ADS_TEST": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "ADS_TEST": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6817840000"
      },
      "android": {
        "serviceAccountKeyPath": "/home/greg/.config/columbiafoundry/play-service-account.json",
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
